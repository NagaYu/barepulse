# BarePulse — environment configuration.
# Copy to ".env" (or export these in your process manager) before going public.

# Set to "production" to REFUSE startup if SALT/PASSWORD are insecure.
BAREPULSE_ENV=production

# REQUIRED in production. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
BAREPULSE_SALT=replace-with-a-64-char-random-hex-string

# Dashboard login (HTTP Basic). REQUIRED in production.
BAREPULSE_USER=admin
BAREPULSE_PASSWORD=replace-with-a-strong-password

# Enable ONLY when running behind a trusted reverse proxy (Render, Nginx, …).
# Lets BarePulse read the real client IP from X-Forwarded-For.
BAREPULSE_TRUST_PROXY=true

# Optional Host allow-list (comma separated). Defends against Host-header abuse.
# BAREPULSE_ALLOWED_HOSTS=analytics.example.com

# Rate limiting for /api/collect (per IP).
BAREPULSE_RATE_LIMIT=120
BAREPULSE_RATE_WINDOW=60

# Database. Default is local SQLite. For Postgres:
#   pip install asyncpg
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/barepulse
# DATABASE_URL=sqlite+aiosqlite:///./barepulse.db
